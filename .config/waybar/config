{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
        "cpu",
        "memory",
        "custom/vpn", 
        "pulseaudio", 
        "group/hardware",
        "tray"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": {
            "*": 10 
        },
    },
    "clock": {
      "format": "{:%H:%M [ %d.%b ]}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "interval": 1,
        "format": "CPU:{usage}%",
        "max-length": 10,
        "on-click": "foot -e htop" 
    },
    "memory": {
        "interval": 30,
        "format": "MEMORY:{}%",
        "max-length": 10,
        "tooltip-format": "Usage: {used:0.1f}G / {total:0.1f}G",
        "on-click": "foot -e htop" 
    },
    "pulseaudio": {
        "format": "VOLUME:{volume}%",
    },
    "custom/vpn": {
      "format": "{}",
      "exec": "sh -c 'if ip addr show | grep -q \"proton0\"; then echo \"VPN:ON\"; else echo \"VPN:OFF\"; fi'",
      "interval": 5,
      "tooltip": false
    },
    "tray": {
      "spacing": 10
    },
}
