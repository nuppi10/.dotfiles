[global]
    background = "#161616"
    foreground = "#f2f4f8"
    frame_color = "#78a9ff"
    font = "monospace 8"
    padding = 8
    horizontal_padding = 8
    separator_height = 2
    border_width = 1

[urgency_low]
    timeout = 4
    background = "#161616"
    foreground = "#f2f4f8"
    frame_color = "#33b1ff"

[urgency_normal]
    timeout = 8
    background = "#161616"
    foreground = "#f2f4f8"
    frame_color = "#be95ff"

[urgency_critical]
    timeout = 0
    background = "#161616"
    foreground = "#f2f4f8"
    frame_color = "#ff0000"
